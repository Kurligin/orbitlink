# Переменные развёртывания на сервере svo. Секретов здесь нет.
#
# Сервер общий: 80/443 держит системный Caddy, соседние проекты занимают
# 127.0.0.1:3000, 3100, 8001, 8081, 8090, 8100, 9090, 9093.
# Контейнеры OrbitLink слушают только localhost, наружу их выпускает Caddy.

COMPOSE_PROJECT_NAME=orbitlink
FRONTEND_BIND=127.0.0.1
FRONTEND_PORT=8095
BACKEND_PORT=8096

# Сервер — 2 ядра и 3.8 ГБ памяти на всех соседей: образы собираются
# по одному, а не параллельно, чтобы сборка фронта не выдавила соседей из памяти.
COMPOSE_PARALLEL_LIMIT=1
